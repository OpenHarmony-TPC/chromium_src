<?xml version="1.0" encoding="utf-8"?>
<grit-part>
  <!-- ohos blocking page-->
  <message name="IDS_OHOS_BLOCK_PAGE_TITLE" use_name_for_id="true" desc="The title of the block page shown when the requested URL is unsafe">
   Note
  </message>
  <message name="IDS_OHOS_BLOCK_PAGE_INFO_TITLE" use_name_for_id="true" desc="The title of the block page shown when the requested URL is unavaiable">
   Website blocked
  </message>
  <message name="IDS_OHOS_BLOCK_PAGE_FRAUD_INFO_TITLE" use_name_for_id="true" desc="The title of the block page shown when the requested URL is unavaiable">
   Beware of fraud
  </message>
  <message name="IDS_OHOS_BLOCK_PAGE_RISK_INFO_TITLE" use_name_for_id="true" desc="The title of the block page shown when the requested URL contains risky content">
   Harmful content ahead
  </message>
  <message name="IDS_OHOS_BLOCK_PAGE_URL_TRUST_LIST_TITLE" use_name_for_id="true" desc="The title of the block page shown when the requested URL is restricted.">
   Access restricted
  </message>
  <message name="IDS_OHOS_BLOCK_PAGE_ILLEGAL_INFO_BODY" use_name_for_id="true" desc="Message informing the user this website is illegal and cann't access it">
   This site can't be accessed because it contains illegal or prohibited content.
  </message>
  <message name="IDS_OHOS_BLOCK_PAGE_FRAUD_INFO_BODY" use_name_for_id="true" desc="Message informing the user this website is illegal and cann't access it">
   This site may try to scam you. Please protect your personal information.
  </message>
  <message name="IDS_OHOS_BLOCK_PAGE_RISK_INFO_BODY" use_name_for_id="true" desc="Message informing the user this website is illegal and cann't access it">
   This site is not secure. Please protect your personal information.
  </message>
  <message name="IDS_OHOS_MINOR_PROTECTION_NOTE" use_name_for_id="true" desc="Message informing the user this website cann't be accessed in Youth Mode">
   Youth mode is on. This site can't be accessed.
  </message>
  <message name="IDS_OHOS_MINOR_PROTECTION_SETING_BUTTON" use_name_for_id="true" desc="Open settings">
   Settings
  </message>
  <message name="IDS_OHOS_BLOCK_PAGE_DONT_PROCEED" use_name_for_id="true" desc="Go back">
   Back
  </message>
  <message name="IDS_OHOS_BLOCK_PAGE_PROCEED" use_name_for_id="true" desc="Continue to the site anyway">
   Continue
  </message>
</grit-part>
