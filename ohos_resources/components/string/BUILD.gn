import("//build/config/locales.gni")
import("//tools/grit/grit_rule.gni")

group("string") {
  public_deps = [ ":ohos_components_strings" ]
}

grit("ohos_components_strings") {
  source = "../ohos_components_strings.grd"
  outputs = [ "grit/ohos_components_strings.h" ]
  foreach(locale, ohos_platform_pak_locales) {
    outputs += [ "ohos_components_strings_$locale.pak" ]
  }
}
