<translation id="IDS_OHOS_BLOCK_PAGE_PROCEED">متابعة</translation>
<translation id="IDS_OHOS_MINOR_PROTECTION_NOTE">وضع القاصرين مشغّل. لا يمكن الوصول إلى هذا الموقع.</translation>
