<translation id="IDS_OHOS_BLOCK_PAGE_TITLE">خەۋپ ئەسكەرتمىسى</translation>
<translation id="IDS_OHOS_BLOCK_PAGE_INFO_TITLE">بۇ توربەتنى كۆرۈش توختىتىلدى</translation>
<translation id="IDS_OHOS_BLOCK_PAGE_ILLEGAL_INFO_BODY">بۇ توربەتتە قانۇن ياكى تۈزۈمگە خىلاپ مەزمۇن بار دەپ پاش قىلىنغان، قانۇن-تۈزۈم بويىچە توختىتىلدى.</translation>
<translation id="IDS_OHOS_BLOCK_PAGE_FRAUD_INFO_BODY">بۇ توربەتتە ئالدامچىلىق خەۋپى بار، شەخسىي ئۇچۇر ۋە مۈلۈك بىخەتەرلىكىگە دىققەت قىلىڭ.</translation>
<translation id="IDS_OHOS_BLOCK_PAGE_RISK_INFO_BODY">بۇ توربەتتە خەۋپ بار، شەخسىي ئۇچۇر ۋە مۈلۈك بىخەتەرلىكىگە دىققەت قىلىڭ.</translation>
<translation id="IDS_OHOS_BLOCK_PAGE_DONT_PROCEED">قايتىش</translation>
<translation id="IDS_OHOS_BLOCK_PAGE_PROCEED">داۋاملاشتۇرۇش</translation>
<translation id="IDS_OHOS_BLOCK_PAGE_FRAUD_INFO_TITLE">ئالدامچىلىق خەۋپى</translation>
<translation id="IDS_OHOS_BLOCK_PAGE_RISK_INFO_TITLE">توربەتتە خەۋپ بار</translation>
<translation id="IDS_OHOS_BLOCK_PAGE_URL_TRUST_LIST_TITLE">بۇ توربەت چەكلەنگەن</translation>
<translation id="IDS_OHOS_MINOR_PROTECTION_NOTE">ئۆسمۈر ھالىتى ئوچۇق، بۇ توربەت چەكلەنگەن.</translation>
