<grit current_release="1" latest_public_release="0">
  <outputs>
    <output filename="grit/highlight_specified_content_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="highlight_specified_content_resources.pak" type="data_package" />
  </outputs>
  <release seq="1">
    <includes>
      <include name="IDR_HIGHLIGHT_SPECIFIED_CONTENT_JS" file="dist/highlight_specified_content.js" type="BINDATA" preprocess="false" compress="false"/>
    </includes>
  </release>
</grit>