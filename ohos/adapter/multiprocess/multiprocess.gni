import("//build/config/ohos/config.gni")

declare_args() {
  # Enable creating a native child process by calling NDK.
  # Disable this will use ArkTS API to create child processes.
  enable_native_child_process = true

  # Enable isolated mode when create a native child process.
  # An isolated child process will run in a seperate Security Context(SElinux
  # label).
  # ATTENTION: Currently Crashpad process can not collect data from processes
  # running in isolated mode.
  enable_isolated_child_process = isolated_level == 1
}
