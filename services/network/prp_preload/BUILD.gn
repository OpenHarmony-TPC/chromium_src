import("//build/buildflag_header.gni")

source_set("prp_preload") {
  visibility = [
    "//services/network:network_service",
    "//services/network:tests",
  ]

  include_dirs = [
    "//services/network/prp_preload/include",
    "//services/network/prp_preload/include/preload_runner",
  ]

  deps = [
    "//base",
    "//net/third_party/quiche",
  ]

  sources = [
    "src/disk_cache_backend_factory.cc",
    "src/disk_cache_file.cc",
    "src/disk_cache_info_parser.cc",
    "src/page_res_parallel_preload_mgr_impl.cc",
    "src/preload_runner/preconnect_runner.cc",
    "src/preload_runner/prpp_request_loader_factory_impl.cc",
    "src/preload_runner/prpp_request_loader_impl.cc",
    "src/res_parallel_preload_ctrler.cc",
    "src/res_preload_scheduler.cc",
    "src/res_request_info_cache_mgr.cc",
    "src/res_request_info_updater.cc",
  ]
}
