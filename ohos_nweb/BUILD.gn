  ]

  deps = [
    "//base:base",
    "//content/public/common",
    "//ui/events/keycodes:x11",
    "//url",
  ]

  if (defined(ohos_nweb_ex) && ohos_nweb_ex) {
    deps += [ "//ohos_nweb_ex/overrides/ohos_nweb" ]
  } else {
    sources += [ "src/cef_delegate/nweb_delegate_ohos.cc" ]
  }
}

#################################################

config("nweb_config") {
  defines = [
    "OHOS_NWEB",
    "OS_OHOS",
    "USE_CEF",
  ]

  if (gpu_switch == "off") {
    defines += [ "GPU_RK3568" ]
  }

  include_dirs = [
    "include",
    "src",
  ]

  include_dirs += ohos_src_includes
}

component("nweb_sources") {
  configs += [
    ":nweb_config",
    ":cef_nweb_config",
  ]

  sources = [
    "include/nweb.h",
