import("//build/buildflag_header.gni")
import("//build/config/features.gni")
import("//build/config/ohos/config.gni")
import("//ohos_nweb/src/nweb_sysevent.gni")
import("//tools/grit/grit_rule.gni")
import("//tools/grit/repack.gni")

component("nweb_hilog") {
  sources = [ "src/nweb_hilog.h" ]

  libs = [ "hilog" ]

  include_dirs = ohos_src_includes
  lib_dirs = ohos_libs_dir
}

#################################################

config("cef_nweb_config") {
  include_dirs = [
    "include",
    "src",
    "src/cef_delegate",
    "src/sysevent",
    "//cef",
    "//cef/include",
    "//cef/libcef/browser/net_service",
    "//third_party/skia"
  ]
  include_dirs += ohos_src_includes

  lib_dirs = ohos_libs_dir
  libs = [
    "inputmethod_client.z",
    "ipc_core.z",
    "inputmethod_ability.z",
    "accesstoken_sdk.z",
    "nweb_ohos_adapter.z",
    "hisysevent.z",
  ]

  defines = [ "USING_CHROMIUM_INCLUDES" ]

  if (product_name == "rk3568") {
    defines += [
      "RK3568",
    ]
  }

  if (report_sys_event) {
    defines += [ "REPORT_SYS_EVENT" ]
  }
}

component("cef_nweb") {
  configs += [
    ":cef_nweb_config",
    ":nweb_config",
  ]

  sources = [
    "src/cef_delegate/nweb_access_request_delegate.cc",
    "src/cef_delegate/nweb_access_request_delegate.h",
    "src/cef_delegate/nweb_application.cc",
    "src/cef_delegate/nweb_application.h",
    "src/cef_delegate/nweb_context_menu_params_impl.cc",
    "src/cef_delegate/nweb_context_menu_params_impl.h",
    "src/cef_delegate/nweb_controller_handler_impl.cc",
    "src/cef_delegate/nweb_controller_handler_impl.h",
    "src/cef_delegate/nweb_cookie_manager_delegate.cc",
    "src/cef_delegate/nweb_cookie_manager_delegate.h",
    "src/cef_delegate/nweb_data_base_delegate.cc",
    "src/cef_delegate/nweb_data_base_delegate.h",
    "src/cef_delegate/nweb_data_resubmission_callback_impl.cc",
    "src/cef_delegate/nweb_data_resubmission_callback_impl.h",
    "src/cef_delegate/nweb_delegate.cc",
    "src/cef_delegate/nweb_delegate.h",
    "src/cef_delegate/nweb_display_listener.cc",
    "src/cef_delegate/nweb_display_listener.h",
    "src/cef_delegate/nweb_event_handler.cc",
    "src/cef_delegate/nweb_event_handler.h",
    "src/cef_delegate/nweb_file_selector_params_impl.cc",
