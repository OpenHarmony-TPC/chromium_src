#!/bin/bash



base_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

cd ${base_dir}

echo ${base_dir}



prebuilts_native_path="native-linux-x64-5.1.0.107-Release.zip"

prebuilts_ets_path="ets-linux-x64-5.1.0.107-Release.zip"

prebuilts_js_path="js-linux-x64-5.1.0.107-Release.zip"

prebuilts_previewer_path="previewer-linux-x64-5.1.0.107-Release.zip"

prebuilts_toolchains_path="toolchains-linux-x64-5.1.0.107-Release.zip"



prebuilts_llvm_path="llvm-linux-x86_64_stripped.tar.gz"

prebuilts_rust_path="rust-toolchain.tar.gz"



sdk_upgrade() {

  if [ ! -d "openharmony" ]; then

    mkdir -p "openharmony"

    pushd openharmony

      unzip ../$prebuilts_ets_path

      unzip ../$prebuilts_native_path

      unzip ../$prebuilts_js_path

      unzip ../$prebuilts_previewer_path

      unzip ../$prebuilts_toolchains_path

    popd

  fi



  api_version=$(grep -o '"apiVersion": *"[^"]*"' 'openharmony/ets/oh-uni-package.json' | grep -o '"[^"]*"$' | tr -d '"')



  if [ ! -d "$api_version" ]; then

    mkdir -p "$api_version"

    if [ $? -ne 0 ]; then

      echo "ERROR: Failed to init SDK, result: ${rc}"

      return ${rc}

    fi

    cp -r openharmony/ets openharmony/js openharmony/toolchains openharmony/previewer $api_version

  fi



  if [ ! -d "ohos-sdk" ]; then

    mkdir -p "ohos-sdk"

    if [ $? -ne 0 ]; then

      echo "ERROR: Failed to init SDK, result: ${rc}"

      return ${rc}

    fi

    pushd ohos-sdk

      ln -s ../openharmony linux

    popd

  fi

}



llvm_upgrade() {

  if [ ! -d "llvm" ]; then

    #将编译工具链替换为19版本

    tar -xzf $prebuilts_llvm_path
    rm -rf llvm/lib/aarch64-linux-ohos/libc++.so
    rm -rf llvm/lib/x86_64-linux-ohos/libc++.so
    rm -rf llvm/lib/arm-linux-ohos/libc++.so
    if [ -d "llvm/lib/clang/19" ]; then

      pushd llvm/lib/clang

      ln -s 19 current

      popd

    fi

    rc=$?

    if [ ${rc} -ne 0 ]; then

      echo "ERROR: Failed to extract llvm tarball: ${base_dir}/llvm.tar.gz, result: ${rc}"

      return ${rc}

    fi

    rm -rf openharmony/native/llvm

    cp -r llvm openharmony/native/

  fi

}



rust_upgrade() {

  if [ ! -d "rust-toolchain" ]; then

    tar zxf "rust-toolchain.tar.gz"

    rc=$?

    if [ ${rc} -ne 0 ]; then

      echo "ERROR: Failed to extract rust toolchain tarball: ${base_dir}/rust-toolchain.tar.gz, result: ${rc}"

      return ${rc}

    fi

    cd "${base_dir}/../third_party"

    rm -rf rust-toolchain -r

    cp "${base_dir}/rust-toolchain.tar.gz" .

    tar zxf "rust-toolchain.tar.gz"

    rc=$?

    if [ ${rc} -ne 0 ]; then

      echo "ERROR1: Failed to extract rust toolchain tarball: ${base_dir}/rust-toolchain.tar.gz, result: ${rc}"

      return ${rc}

    fi

    return ${rc}

  fi

}



sdk_upgrade

llvm_upgrade

rust_upgrade
