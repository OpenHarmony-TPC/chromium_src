#!/bin/bash

base_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
cd ${base_dir}
echo ${base_dir}

prebuilts_sdk_path="../../prebuilts/ohos-sdk/linux"
target_dir=$(find "$prebuilts_sdk_path" -maxdepth 1 -type d -name '[0-9]*' | sort -V | tail -n 1)
max_api_version=$(basename "$target_dir")

prebuilts_llvm_path="../../prebuilts/llvm/llvm/llvm.tar.gz"
prebuilts_rust_path="../../prebuilts/rust/rust/rust-toolchain.tar.gz"

sdk_upgrade() {
  if [ ! -d "openharmony" ]; then
    mkdir -p "openharmony"
    if [ $? -ne 0 ]; then
      echo "ERROR: Failed to init SDK, result: ${rc}"
      return ${rc}
    fi
    find ${target_dir} -name "*.zip" -print0 | xargs -0 -I {} unzip -q {} -d openharmony/
  fi

  if [ ! -d "$max_api_version" ]; then
    mkdir -p "$max_api_version"
    if [ $? -ne 0 ]; then
      echo "ERROR: Failed to init SDK, result: ${rc}"
      return ${rc}
    fi
    cp -r openharmony/ets openharmony/js openharmony/toolchains openharmony/previewer $max_api_version
  fi

  if [ ! -d "ohos-sdk" ]; then
    mkdir -p "ohos-sdk"
    if [ $? -ne 0 ]; then
      echo "ERROR: Failed to init SDK, result: ${rc}"
      return ${rc}
    fi
    pushd ohos-sdk
      ln -s ../openharmony linux
    popd
  fi
}

llvm_upgrade() {
  if [ ! -d "llvm" ]; then
    #将编译工具链替换为19版本
    tar -xzf $prebuilts_llvm_path
    if [ -d "llvm/lib/clang/19" ]; then
      pushd llvm/lib/clang
      ln -s 19 current
      popd
    fi
    rc=$?
    if [ ${rc} -ne 0 ]; then
      echo "ERROR: Failed to extract llvm tarball: ${base_dir}/llvm.tar.gz, result: ${rc}"
      return ${rc}
    fi
    rm -rf openharmony/native/llvm
    cp -r llvm openharmony/native/
  fi
}
 
rust_upgrade() {
  if [ ! -d "rust-toolchain" ]; then
    if [ -f "rust-toolchain.tar.gz" ]; then
      rm -f "rust-toolchain.tar.gz"
    fi
    cp $prebuilts_rust_path .
    tar zxf "rust-toolchain.tar.gz"
    rc=$?
    if [ ${rc} -ne 0 ]; then
      echo "ERROR: Failed to extract rust toolchain tarball: ${base_dir}/rust-toolchain.tar.gz, result: ${rc}"
      return ${rc}
    fi
    cd "${base_dir}/../third_party"
    rm -rf rust-toolchain -r
    cp "${base_dir}/rust-toolchain.tar.gz" .
    tar zxf "rust-toolchain.tar.gz"
    rc=$?
    if [ ${rc} -ne 0 ]; then
      echo "ERROR1: Failed to extract rust toolchain tarball: ${base_dir}/rust-toolchain.tar.gz, result: ${rc}"
      return ${rc}
    fi
    return ${rc}
  fi
}

sdk_upgrade
llvm_upgrade
rust_upgrade