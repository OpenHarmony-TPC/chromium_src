## add ohos fuzz test case here
group("ohos_fuzz") {
  testonly = true
  deps = []
}

## add chromium fuzz test case here
group("chromium_fuzz") {
  testonly = true
  deps = [ "//base:base64_decode_fuzzer" ]
}

## add ohos unit test case here
group("ohos_unittest") {
  testonly = true
  deps = []
}

## add chromium unit test case here
group("chromium_unittest") {
  testonly = true
  deps = []
}

group("ohos_test") {
  testonly = true
  deps = [
    ":chromium_fuzz",
    ":chromium_unittest",
    ":ohos_fuzz",
    ":ohos_unittest",
  ]
}

####################################

fuzzer_test("clipboard_fuzzer") {
  sources =
      [ "fuzztest/content/browser/renderer_host/clipboard_host_fuzzer.cc" ]
  deps = [
    "//base",
    "//content/browser",
  ]
  include_dirs = [
    "//cef",
    "//content/browser/renderer_host",
    "//ui/base/clipboard",
    "//content/public/browser",
  ]
}

fuzzer_test("nweb_inputmethod_fuzzer") {
  sources = [ "fuzztest/ohos_mweb/nweb_inputmethod_fuzzer.cc" ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
  ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:nweb_sources",
  ]
}

fuzzer_test("nweb_delegate_fuzzer") {
  sources = [ "fuzztest/ohos_mweb/cef_delegate/nweb_delegate_fuzzer.cc" ]
  include_dirs = [
    "//cef",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
  ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
  ]
}

fuzzer_test("native_loader_fuzzer") {
  sources = [
    "fuzztest/native_loader_fuzzer.cc",
  ]
  include_dirs = [
    "//third_party/blink",
