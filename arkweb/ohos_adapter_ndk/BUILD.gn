_auto_gni_path = "$target_gen_dir/adapter_ndk_config.gni"
_script = "//arkweb/ohos_adapter_ndk/ndk_tools/gen_ndk.py"
_args = [
  "--input", rebase_path("//arkweb/ohos_adapter_ndk/ndk_tools/adapter_ndk_api.json", root_build_dir),
  "--output", rebase_path(target_gen_dir, root_build_dir),
  "--absolute", target_gen_dir,
  "--version", "15",
]

exec_script(_script,  _args)

import(_auto_gni_path)
import("//arkweb/build/features/features.gni")

action("adapter_ndk_gen") {
  script = _script
  outputs = stub_sources + wrapper_sources
}

shared_library("adapter_ndk_stub") {
  sources = stub_sources

  deps = [":adapter_ndk_gen"]
}

declare_args() {
  webview_only = true
  webview_print_enable = true
  if (defined(global_parts_info) &&
      !defined(global_parts_info.print_print_fwk)) {
    webview_print_enable = false
  }
}

################################### string_utils ########################################
config("string_utils_config") {
  include_dirs = [
    "utils/include",
    "utils/extractortool/include",
    "interfaces",
  ]
}

component("adapter_string_utils") {
  sources = [ "utils/extractortool/src/file_path_utils.cpp" ]

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  public_configs = [ ":string_utils_config" ]
}

################################### extractortool ########################################
config("ability_extractor_config") {
  include_dirs = [
    "utils/include",
    "utils/extractortool/include",
    "//third_party/zlib/",
    "//third_party/zlib/contrib/minizip",
    "interfaces",
    "//third_party/ohos_ndk/includes/ohos_adapter",
  ]
}

component("adapter_extractortool") {
  sources = [
    "utils/extractortool/src/extractor.cpp",
    "utils/extractortool/src/file_mapper.cpp",
    "utils/extractortool/src/zip_file.cpp",
    "utils/extractortool/src/zip_file_reader.cpp",
    "utils/extractortool/src/zip_file_reader_io.cpp",
  ]

  include_dirs = [
    "hiviewdfx_adapter/include",
  ]

  cflags = []
  cflags_cc = []

  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  deps = [
    ":adapter_string_utils",
    "//third_party/zlib:zlib",
  ]

  public_configs = [ ":ability_extractor_config" ]
}

config("adapter_ndk_config") {
  ldflags = wrapper_ldflags
}

source_set("adapter_ndk_wrapper") {
  sources = wrapper_sources
  sources += [
    "ndk_version.cc",
  ]

  deps = [":adapter_ndk_gen"]
  public_configs = [ ":adapter_ndk_config" ]

  lib_dirs = [ root_build_dir ]
  libs = [ "adapter_ndk_stub" ]
}

