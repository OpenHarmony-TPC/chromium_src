import("//testing/test.gni")
import("//arkweb/build/features/features.gni")

test("ohos_nweb_unittests") {
  configs += []

  include_dirs = [ "//ppapi/lib/gl/include" ]

  sources = [
    "ohos_nweb_test_suite.cc",
    "ohos_nweb_test_suite.h",
    "run_all_unittests.cc",
  ]

  public_deps = [
    "//testing/gmock",
    "//testing/gtest",
  ]

  deps = [
    "//ohos_nweb:unittests",
    "//base",
    "//base/test:test_support",
    "//third_party/boringssl",
    "//ohos_glue:ohos_nweb_glue_source",
    "//ohos_glue:ohos_adapter_glue_source",
    "//third_party/boringssl",
    "//content/public/common",
  ]

  if (enable_arkweb_ext) {
    deps += [ "//ohos_nweb_ex/test:ohos_nweb_ex_unittests", ]
  }

  if (arkweb_unittests) {
    configs += [
      "//arkweb/chromium_ext:ohos_nweb_unittests_config",
    ]
  }
}
