#################################################

config("ohosnweb_core_config") {
  defines = [
    "OHOS_NWEB",
    "OS_OHOS",
  ]

  include_dirs = [
    "//cef",
    "//cef/include",
    "$root_out_dir/includes/cef"
  ]

  include_dirs += ohos_src_includes
}

action("check_ndk_symbol") {
  script = "//arkweb/ohos_adapter_ndk/ndk_tools/check_ndk.py"

  inputs = [
    "//arkweb/ohos_adapter_ndk/ndk_tools/adapter_ndk_api.json",
  ]

  outputs = [
    "$target_out_dir/check_ndk_symbol.stamp",
  ]

  args = [
      "--input", rebase_path(inputs[0], root_build_dir),
  ]

  deps = [ "//cef:libarkweb_engine" ]
}

shared_library("libarkweb_render") {
  configs += [
    "//arkweb/build/config/sanitizers:cfi_config",
    "//cef/libcef/features:config",
  ]
  defines = [ "OHOS_NWEB" ]

  include_dirs = [ "include" ]
  include_dirs += ohos_src_includes

  sources = [
    "src/nweb_render_main.cc",
    "src/set_renderer_seccomp_policy.cc",
  ]

  deps = [
    "//base",
    ":nweb_hilog",
    "//cef:libcef_dll_wrapper",
    "//cef:libarkweb_engine",
    ":check_ndk_symbol",
    "//sandbox:sandbox",
    "//cef/libcef/features",
  ]
}

