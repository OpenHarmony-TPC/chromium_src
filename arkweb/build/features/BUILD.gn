# This file is in a separate directory so all targets in the build can refer to
# the buildflag header to get the necessary preprocessor defines without
# bringing in any ArkWeb targets. Other targets can depend on this target
# regardless of whether ArkWeb is being built. Set the `enable_arkweb=false` GN arg to
# disable the ArkWeb changes when building Chrome.
#
# Example usage:
#
# 1. An existing GN configuration file at path/to/foo/BUILD.gn:
#
#    # Import the `enable_arkweb` arg.
#    import("//arkweb/build/features/features.gni")
#    ...
#
#    # An existing target that is modified for ArkWeb.
#    # The target type might instead be `component`, `source_set`, etc.
#    static_library("foo") {
#      sources = [ ... ]
#
#      deps = [
#        # Always include the ArkWeb features.
#        "//arkweb/build/features",
#        ...
#      ]
#
#      if (enable_arkweb) {
#        # Actions to perform when the ArkWeb build is enabled.
#
#        # Optionally include ArkWeb source files directly in this target. This
#        # approach is required for targets that are either directly or
#        # indirectly included in a `component` target (otherwise
#        # `is_component_build=true` builds will fail). Keep in mind that these
#        # files are part of this target instead of the `libcef_static` target
#        # and therefore subject to any target-specific configuration settings
#        # such as include paths, defines, compiler flags, etc.
#        sources += [
#          "//xxx/foo_helper.cc",
#          "//xxx/foo_helper.h",
#        ]
#     }
#     ...
#   }
#
# 2. An existing C++ source file at path/to/foo/foo.cc:
#
#    // Include the `BUILDFLAG(ENABLE_ARKWEB_TEST)` definition.
#    #include "arkweb/build/features/features.h"
#    ...
#
#    #if BUILDFLAG(ENABLE_ARKWEB_TEST)
#    // ArkWeb needed headers here...
#    #include "arkweb/include/xxx.h"
#    #else
#    // Chrome headers here...
#    #endif
#
#    // An existing function that is modified for ArkWeb.
#    void DoFoo() {
#    #if BUILDFLAG(ENABLE_ARKWEB_TEST)
#      // ArkWeb implementation here...
#      cef_foo_helper::DoFoo();
#    #else
#      // Chrome implementation here...
#    #endif  // !BUILDFLAG(ENABLE_ARKWEB_TEST)
#    }
#    ...
#

# Configuration for all targets that include ArkWeb source code library-side.
