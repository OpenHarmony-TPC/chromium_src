import("//arkweb/build/features/features.gni")

group("arkweb_test_targets") {
    testonly = true

    deps = [
      "//arkweb/build/unittests:oh_base_unittests",
      "//arkweb/build/unittests:oh_core_unittests",
      "//arkweb/build/unittests:oh_smoke_unittests",
    ]
}

group("mojo_pre") {
  testonly = true
  deps = []
  if (enable_mojom_gni) {
    import("$root_build_dir/mojom_targets.gni")
    print("enable_mojom_gni is ok")
    if (defined(mojom_targets) && mojom_targets != []) {
      deps += mojom_targets
    }
  }
}