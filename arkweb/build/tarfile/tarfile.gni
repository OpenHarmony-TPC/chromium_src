# Template to build custom tarfile.
#
# Variables:
#   output: Output tarball filename, required.
#   files:  Files will be added to the tarball, required.
template("ohos_tarfile") {
  action(target_name) {
    script = "//arkweb/build/tarfile/build_tarfile.py"
    forward_variables_from(invoker, [ "deps" ])

    assert(defined(invoker.output), "output is required for ohos_tarfile")
    outputs = [ invoker.output ]

    args = [
      "--output",
      rebase_path(invoker.output),
    ]

    inputs = [ script ]
    assert(defined(invoker.files), "files is required for ohos_tarfile")
    foreach(_file_pair, invoker.files) {
      _map = []
      _map = string_split(_file_pair, ":")
      inputs += [ _map[0] ]

      args += [ "--files", _file_pair ]
    }
  }
}
