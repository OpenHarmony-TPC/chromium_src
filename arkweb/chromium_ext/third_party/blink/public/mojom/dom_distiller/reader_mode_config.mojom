module blink.mojom;

enum DetailTemplateIndex {
  INFO,
  INTRO,
  CHAPTERS
};

enum ContentTemplateIndex {
  CONTENT,
  PAGER
};

enum ContentFeatureIndex {
  PREV,
  NEXT,
  CATALOG
};

struct ReaderModeConfig {
  bool is_v2;
  bool reader_mode_enabled;
  map<int32, array<string>> detail_templates;
  map<int32, array<string>> content_templates;
  map<ContentFeatureIndex, array<string>> content_features;
  // content template metadataConfig
  bool must_have_catalog;
  bool must_have_prev_and_next;
  int32 minimum_content_length;
};

struct UrlHostDistillerInfo {
  bool is_distillable = false;
  array<int32> templates_for_host;
  array<string> detail_regexes;
  array<string> content_regexes;
  array<string> blacklist_regexes;
};
