module blink.mojom;

import "url/mojom/url.mojom";

struct VideoExpParams {
  int64 start_used_time;
  int64 total_freeze_time;
  int64 total_played_time;
  int32 video_freeze_cnt;
  int32 error_code;
  string error_msg;
  string page_url;
  string video_src;
  string pipeline_status;
  string mime_type;
  int32 net_error_code;
  int64 video_duration;
  int32 video_width;
  int32 video_height;
  string video_player;
};

interface VideoExperienceReporter {
  ReportVideoExperienceToBI(VideoExpParams params);
};