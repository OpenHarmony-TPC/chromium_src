import("//build/buildflag_header.gni")
import("//build/config/features.gni")
import("//build/config/ohos/config.gni")
import("//ohos_nweb/src/nweb_sysevent.gni")
import("//tools/grit/grit_rule.gni")
import("//tools/grit/repack.gni")
import("//testing/libfuzzer/fuzzer_test.gni")
import("//testing/test.gni")
import("//arkweb/build/features/features.gni")

fuzzer_test("event_reporter_fuzzer") {
  sources = [ "event_reporter_fuzzer.cpp" ]
  include_dirs = [
    "//cef",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//arkweb/chromium_ext/ohos_nweb/src/sysevent",
  ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
  ]
}

fuzzer_test("oh_web_performance_timing_fuzzer") {
  sources = [ "oh_web_performance_timing_fuzzer.cpp" ]
  include_dirs = [
    "//cef",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//arkweb/chromium_ext/ohos_nweb/src/sysevent",
  ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
  ]
}

## SysEvent Fuzzers
group("sysevent_fuzzers") {
  testonly = true
  deps = [
    ":event_reporter_fuzzer",
    ":oh_web_performance_timing_fuzzer",
  ]
}
