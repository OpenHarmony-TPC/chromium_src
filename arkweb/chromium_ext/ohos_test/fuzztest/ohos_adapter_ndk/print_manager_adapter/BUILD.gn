    "//arkweb/ohos_adapter_ndk/print_manager_adapter",
    "//ohos_sdk/openharmony/native/sysroot/usr/include",
  ]
  defines = [ "NWEB_PRINT_ENABLE" ]
  deps = [
    "//arkweb/ohos_adapter_ndk:adapter_ndk_stub",
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
  ]
