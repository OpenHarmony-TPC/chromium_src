import("//build/buildflag_header.gni")
import("//build/config/features.gni")
import("//build/config/ohos/config.gni")
import("//ohos_nweb/src/nweb_sysevent.gni")
import("//tools/grit/grit_rule.gni")
import("//tools/grit/repack.gni")
import("//testing/libfuzzer/fuzzer_test.gni")
import("//testing/test.gni")
import("//arkweb/build/features/features.gni")

fuzzer_test("proc_info_ohos_fuzzer") {
  sources = [ "proc_info_ohos_fuzzer.cpp" ]
  include_dirs = [
    "//cef",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
  ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
  ]
}

fuzzer_test("ptrace_broker_utils_fuzzer") {
  sources = [ "ptrace_broker_utils_fuzzer.cpp" ]
  include_dirs = [
    "//cef",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
    "//third_party/crashpad/crashpad/client",
  ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//third_party/crashpad/crashpad/client",
  ]
}

## group for all frame module Fuzzers
group("crashpad_util_linux_fuzzers") {
  testonly = true
  deps = [
    ":ptrace_broker_utils_fuzzer",
    ":proc_info_ohos_fuzzer",
  ]
}
