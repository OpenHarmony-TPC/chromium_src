import("//testing/libfuzzer/fuzzer_test.gni")

fuzzer_test("platform_sensor_provider_ohos_fuzzer") {
  sources = [ "platform_sensor_provider_ohos_fuzzer_test.cpp" ]
  deps = [
    "//services/device:tests",
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
