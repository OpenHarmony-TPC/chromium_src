  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//arkweb/chromium_ext",
    "//arkweb/chromium_ext/services",
  ]
}

fuzzer_test("platform_sensor_ohos_fuzzer") {
  sources = [ "platform_sensor_ohos_fuzzer_test.cpp" ]
  deps = [
    "//services/device:tests",
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
  ]
  include_dirs = [
    "//cef",
    "//cef/include",
    "//ohos_nweb/include",
    "//arkweb/chromium_ext",
    "//arkweb/chromium_ext/services",
  ]
}

group("ohos_platform_sensor_fuzz") {
  testonly = true
  deps = [
    ":platform_sensor_provider_ohos_fuzzer",
    ":platform_sensor_ohos_fuzzer",
  ]
}
