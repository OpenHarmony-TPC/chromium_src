import("//build/config/features.gni")
import("//testing/libfuzzer/fuzzer_test.gni")

fuzzer_test("dfx_reporter_browser_impl_fuzzer") {
  sources = [ "dfx_reporter_browser_impl_fuzzer.cpp" ]
  include_dirs = [
    "//cef",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
  ]
  deps = [
    "//arkweb/ohos_adapter_ndk:adapter_ndk_stub",
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
  ]
}

fuzzer_test("memory_monitor_render_impl_fuzzer") {
  sources = [ "memory_monitor_render_impl_fuzzer.cpp" ]
  include_dirs = [
    "//cef",
    "//ohos_nweb/include",
    "//ohos_nweb/src",
  ]
  deps = [
    "//cef:libcef_static",
    "//ohos_nweb:cef_nweb",
    "//ohos_nweb:nweb_sources",
    "//v8",
    "//base",
    "//mojo/core/embedder",
  ]
}

## DFX Browser Fuzzers
group("browser_dfx_fuzzers") {
  testonly = true
  deps = [
    ":dfx_reporter_browser_impl_fuzzer",
    ":memory_monitor_render_impl_fuzzer",
  ]
}