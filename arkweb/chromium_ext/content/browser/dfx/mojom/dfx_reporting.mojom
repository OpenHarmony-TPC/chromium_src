module dfx.mojom;

interface DfxReporter {
  ReportMemInfo(string sysEventInfoJson);
  ReportHiSysEvent(string eventName, string sysEventInfoJson);
};

struct FreezeInfo {
  int32 pid;
  string processName;
  string freezeMsg;
  int32 uid;
}

interface FreezeReporter {
  ReportRenderFreeze(FreezeInfo freezeInfo);
};