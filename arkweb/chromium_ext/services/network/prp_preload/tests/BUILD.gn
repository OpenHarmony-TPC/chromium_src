import("//testing/test.gni")
import("//arkweb/build/features/features.gni")

test("prp_preload_unittests") {
  testonly = true

  sources = [
    "res_request_info_updater_unittest.cc",
    "res_request_info_cache_mgr_unittest.cc",
    "disk_cache_file_unittest.cc",
    "disk_cache_info_parser_unittest.cc",
    "page_res_parallel_preload_mgr_impl_unittest.cc",
    "prpp_request_loader_factory_impl_unittest.cc",
    "res_parallel_preload_ctrler_unittest.cc",
    "res_preload_scheduler_unittest.cc",
    "prpp_request_loader_impl_unittest.cc",
  ]

  include_dirs = [
    "//arkweb/chromium_ext/services/network/prp_preload/include",
    "//arkweb/chromium_ext/services/network/prp_preload/include/preload_runner",
  ]

  cflags = [ "-fno-access-control" ]
  cflags_cc = [ "-fno-access-control" ]

  deps = [
    "//arkweb/chromium_ext/services/network/prp_preload",
    "//base",
    "//content/public/common:static_switches",
    "//net/third_party/quiche",
    "//services/network/public/mojom",
    "//services/network:test_support",
    "//services/test:run_all_unittests",
    "//ohos_glue:ohos_adapter_glue_source",
    "//third_party:huawei_securec",
    "//testing/gmock",
    "//testing/gtest",
  ]
}