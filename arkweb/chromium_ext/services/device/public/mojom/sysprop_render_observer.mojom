module device.mojom;

interface SysPropRenderObserver {
  // Add a client that will get notified on system properties changes. No throttling is
  // employed, as system properties changes are infrequent enough that there is no
  // realistic risk of flooding.
  Attach(pending_remote<SysPropRenderObserverClient> client);
  Detach(pending_remote<SysPropRenderObserverClient> client);
  
};

interface SysPropRenderObserverClient {
  // Called on a system properties change.
  TracePropertiesUpdate(string value);
  DumpPropertiesUpdate(string value);
};
