import("//arkweb/build/features/features.gni")

arkweb_base_ext_sources = []

arkweb_base_ext_sources += [
  "//arkweb/chromium_ext/base/message_loop/message_pump_ohos.cc",
  "//base/profiler/stack_sampler_android.cc",
  "//arkweb/chromium_ext/base/ohos/sys_info_utils_ext.cc",
  "//arkweb/chromium_ext/base/ohos/sys_info_utils_ext.h",
  "//arkweb/chromium_ext/base/ohos/dynamic_frame_loss_monitor.cc",
  "//arkweb/chromium_ext/base/ohos/dynamic_frame_loss_monitor.h",
]

if (arkweb_file_upload) {
  arkweb_base_ext_sources += [
    "//arkweb/chromium_ext/base/datashare_uri_utils.cc",
    "//arkweb/chromium_ext/base/datashare_uri_utils.h",
    "//arkweb/chromium_ext/base/report_loss_frame_ext.cc",
    "//arkweb/chromium_ext/base/report_loss_frame_ext.h",
  ]
}

if (arkweb_i18n) {
  arkweb_base_ext_sources += [
    "//arkweb/chromium_ext/base/ohos/locale_utils.cc",
    "//arkweb/chromium_ext/base/ohos/locale_utils.h",
  ] 
}

if (arkweb_vulkan) {
  arkweb_base_ext_sources += [
    "//arkweb/chromium_ext/base/ohos/scoped_native_buffer_handle.cc",
    "//arkweb/chromium_ext/base/ohos/scoped_native_buffer_handle.h",
  ]
}

arkweb_base_ohos_ltpo_sources = [
  "//arkweb/chromium_ext/base/ohos/ltpo/src/dynamic_frame_rate_decision.cc",
  "//arkweb/chromium_ext/base/ohos/ltpo/include/dynamic_frame_rate_decision.h",
  "//arkweb/chromium_ext/base/ohos/ltpo/src/sliding_observer.cc",
  "//arkweb/chromium_ext/base/ohos/ltpo/include/sliding_observer.h",
  "//arkweb/chromium_ext/base/ohos/ltpo/include/ltpo_strategy.h",
  "//arkweb/chromium_ext/base/ohos/ltpo/src/touch_observer.cc",
  "//arkweb/chromium_ext/base/ohos/ltpo/include/touch_observer.h",
]

