  "//arkweb/chromium_ext/base/arkweb_report_statistics.cc",
  "//arkweb/chromium_ext/base/arkweb_report_statistics.h",
]

if (arkweb_file_upload) {
  arkweb_base_ext_sources += [
    "//arkweb/chromium_ext/base/datashare_uri_utils.cc",
    "//arkweb/chromium_ext/base/datashare_uri_utils.h",
    "//arkweb/chromium_ext/base/report_loss_frame_ext.cc",
    "//arkweb/chromium_ext/base/report_loss_frame_ext.h",
  ]
}

if (arkweb_i18n) {
  arkweb_base_ext_sources += [
    "//arkweb/chromium_ext/base/ohos/locale_utils.cc",
    "//arkweb/chromium_ext/base/ohos/locale_utils.h",
  ] 
}

if (arkweb_vulkan) {
  arkweb_base_ext_sources += [
    "//arkweb/chromium_ext/base/ohos/scoped_native_buffer_handle.cc",
    "//arkweb/chromium_ext/base/ohos/scoped_native_buffer_handle.h",
  ]
}

if (defined(arkweb_logger_report) && arkweb_logger_report) {
  arkweb_base_ext_sources += [
    "//arkweb/chromium_ext/base/ohos/logger.cc",
    "//arkweb/chromium_ext/base/ohos/logger.h",
  ]
}

if (arkweb_crashpad) {
  arkweb_base_ext_sources += [
    "//arkweb/chromium_ext/base/task/task_queue_impl_ext.cc",
    "//arkweb/chromium_ext/base/task/task_queue_impl_ext.h",
  ]
}

if (arkweb_dfx_dump) {
  arkweb_base_ext_sources += [
    "//arkweb/chromium_ext/base/debug/arkweb_dump_info.cc",
    "//arkweb/chromium_ext/base/debug/arkweb_dump_info.h",
  ]
}
