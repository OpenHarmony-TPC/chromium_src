  "//arkweb/chromium_ext/base/files/memory_mapped_file_ext.h",
  "//arkweb/chromium_ext/base/ohos/blankless/blankless_controller.cc",
  "//arkweb/chromium_ext/base/ohos/blankless/blankless_controller.h",
  "//arkweb/chromium_ext/base/ohos/nweb_engine_event_logger.cc",
