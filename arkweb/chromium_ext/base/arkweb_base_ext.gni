arkweb_base_ohos_ltpo_unittests_sources = [
  "//arkweb/chromium_ext/base/ohos/ltpo/src/dynamic_frame_rate_decision_unittest.cc",
  "//arkweb/chromium_ext/base/ohos/ltpo/src/sliding_observer_unittest.cc",
]
