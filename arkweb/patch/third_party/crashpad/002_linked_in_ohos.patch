From 1e433d73d10d9a6eaf8963329f8d8a9ce63f81de Mon Sep 17 00:00:00 2001
From: fooljohnny <fooljohnny@gmail.com>
Date: Tue, 24 Sep 2024 19:41:48 +0800
Subject: [PATCH] fix link failed in 'ninja -C out/musl_64
 libchrome_crashpad_handler.so'

---
 crashpad/crashpad/handler/BUILD.gn                      | 2 +-
 crashpad/crashpad/snapshot/BUILD.gn                     | 7 ++++---
 crashpad/crashpad/util/net/tls.gni                      | 2 +-
 crashpad/crashpad/util/numeric/checked_address_range.cc | 6 ++++--
 4 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/crashpad/crashpad/handler/BUILD.gn b/crashpad/crashpad/handler/BUILD.gn
index a5b6ae04f..2803a0e93 100644
--- a/crashpad/crashpad/handler/BUILD.gn
+++ b/crashpad/crashpad/handler/BUILD.gn
@@ -34,7 +34,7 @@ static_library("handler") {
     ]
   }
 
-  if (crashpad_is_linux || crashpad_is_android) {
+  if (crashpad_is_linux || crashpad_is_android || crashpad_is_ohos) {
     sources += [
       "linux/capture_snapshot.cc",
       "linux/capture_snapshot.h",
diff --git a/crashpad/crashpad/snapshot/BUILD.gn b/crashpad/crashpad/snapshot/BUILD.gn
index 2ae944c3e..3c7c3f6a4 100644
--- a/crashpad/crashpad/snapshot/BUILD.gn
+++ b/crashpad/crashpad/snapshot/BUILD.gn
@@ -126,7 +126,7 @@ crashpad_static_library("snapshot") {
     ]
   }
 
-  if (crashpad_is_linux || crashpad_is_android) {
+  if (crashpad_is_linux || crashpad_is_android || crashpad_is_ohos) {
     sources += [
       "linux/capture_memory_delegate_linux.cc",
       "linux/capture_memory_delegate_linux.h",
@@ -159,14 +159,15 @@ crashpad_static_library("snapshot") {
   }
 
   if (crashpad_is_linux || crashpad_is_android || crashpad_is_fuchsia ||
-      crashpad_is_win) {
+      crashpad_is_win || crashpad_is_ohos) {
     sources += [
       "crashpad_types/crashpad_info_reader.cc",
       "crashpad_types/crashpad_info_reader.h",
     ]
   }
 
-  if (crashpad_is_linux || crashpad_is_android || crashpad_is_fuchsia) {
+  if (crashpad_is_linux || crashpad_is_android || crashpad_is_fuchsia ||
+      crashpad_is_ohos) {
     sources += [
       "crashpad_types/image_annotation_reader.cc",
       "crashpad_types/image_annotation_reader.h",
diff --git a/crashpad/crashpad/util/net/tls.gni b/crashpad/crashpad/util/net/tls.gni
index e0249a84c..e8f4e5a24 100644
--- a/crashpad/crashpad/util/net/tls.gni
+++ b/crashpad/crashpad/util/net/tls.gni
@@ -15,7 +15,7 @@
 import("../../build/crashpad_buildconfig.gni")
 
 declare_args() {
-  if (crashpad_is_fuchsia || crashpad_is_android) {
+  if (crashpad_is_fuchsia || crashpad_is_android || crashpad_is_ohos) {
     crashpad_http_transport_impl = "socket"
   } else if (crashpad_is_linux) {
     crashpad_http_transport_impl = "libcurl"
diff --git a/crashpad/crashpad/util/numeric/checked_address_range.cc b/crashpad/crashpad/util/numeric/checked_address_range.cc
index c27defb01..5626ceb32 100644
--- a/crashpad/crashpad/util/numeric/checked_address_range.cc
+++ b/crashpad/crashpad/util/numeric/checked_address_range.cc
@@ -23,7 +23,8 @@
 #include <mach/mach.h>
 #elif BUILDFLAG(IS_WIN)
 #include "util/win/address_types.h"
-#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_ANDROID)
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || \
+    BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_OHOS)
 #include "util/linux/address_types.h"
 #elif BUILDFLAG(IS_FUCHSIA)
 #include <zircon/types.h>
@@ -131,7 +132,8 @@ std::string CheckedAddressRangeGeneric<ValueType, SizeType>::AsString() const {
 template class CheckedAddressRangeGeneric<mach_vm_address_t, mach_vm_size_t>;
 #elif BUILDFLAG(IS_WIN)
 template class CheckedAddressRangeGeneric<WinVMAddress, WinVMSize>;
-#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_ANDROID)
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || \
+    BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_OHOS)
 template class CheckedAddressRangeGeneric<LinuxVMAddress, LinuxVMSize>;
 #elif BUILDFLAG(IS_FUCHSIA)
 template class CheckedAddressRangeGeneric<zx_vaddr_t, size_t>;
-- 
2.25.1

