+      isolation_info().request_type() ==
+          IsolationInfo::RequestType::kMainFrame) {
+    proxy_delegate()->AddSuccessMainFrameHosts(url().host());
+  }
+}
+#endif  // BUILDFLAG(ARKWEB_EX_FALLBACK_PROXY)
+
