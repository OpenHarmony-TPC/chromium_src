module media.mojom;

import "ui/gfx/geometry/mojom/geometry.mojom";

// Implemented by NativeWebContentsObserver::NativeBridgeObserverHostImpl in the
// browser process.
interface NativeBridgeObserver {
  OnCreateNativeSurface(int32 native_embed_id,
                        gfx.mojom.Size size,
                        string native_type);
  UpdateElementId(string element_id);
  UpdateElementSource(string element_source);
  OnEmbedSizeChange(gfx.mojom.Size size);
  OnDestroyNativeSurface();
};

// Implemented by NativeWebContentsObserver::NativeBridgeHostImpl in the browser
// process.
interface NativeBridgeHost {
  // Sends a message to the browser notifying the render frame associated to the
  // document owning the HTMLNativeElement that a new NativeBridge is available,
  // passing a pending remote (i.e. |native_bridge_remote|) that will be used in the
  // browser process to establish a channel with the HTMLNativeElement.
  // |observer| starts observing the NativeBridge as soon as the bridge is
  // created.
  OnNativeBridgeAdded(pending_associated_receiver<NativeBridgeObserver> observer,
                      int32 player_id);
};
