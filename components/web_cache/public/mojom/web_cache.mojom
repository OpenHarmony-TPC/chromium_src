module web_cache.mojom;

interface WebCache {
  // Clear cache.
  ClearCache(bool on_navigation);
  [EnableIf=is_ohos]
  // Add resource into MemoryCache
  AddResourceToCache(string url,
                     string origin,
                     array<uint8> resource,
                     map<string, string> response_headers,
                     uint64 type);
};
