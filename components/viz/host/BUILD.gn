import("//arkweb/build/features/features.gni")
import("//build/config/ui.gni")
import("//components/viz/viz.gni")

viz_component("host") {
  defines = [ "VIZ_HOST_IMPLEMENTATION" ]

  sources = [
    "client_frame_sink_video_capturer.cc",
    "client_frame_sink_video_capturer.h",
    "compositing_mode_reporter_impl.cc",
    "compositing_mode_reporter_impl.h",
    "gpu_client.cc",
    "gpu_client.h",
    "gpu_client_delegate.h",
    "gpu_host_impl.cc",
    "gpu_host_impl.h",
    "host_display_client.cc",
    "host_display_client.h",
    "host_frame_sink_client.h",
    "host_frame_sink_manager.cc",
    "host_frame_sink_manager.h",
    "//arkweb/chromium_ext/components/viz/host/host_frame_sink_manager_utils.cc",
    "//arkweb/chromium_ext/components/viz/host/host_frame_sink_manager_utils.h",
    "//arkweb/chromium_ext/components/viz/host/cancelable_delayed_task_manager.cc",
    "//arkweb/chromium_ext/components/viz/host/cancelable_delayed_task_manager.h",
    "persistent_cache_sandboxed_file_factory.cc",
    "persistent_cache_sandboxed_file_factory.h",
    "renderer_settings_creation.cc",
    "renderer_settings_creation.h",
    "viz_host_export.h",
  ]

  if (arkweb_blank_optimize) {
    sources += [
      "//arkweb/chromium_ext/components/viz/host/blankless_data_controller.cc",
      "//arkweb/chromium_ext/components/viz/host/blankless_data_controller.h",
    ]
  }

  if (is_win) {
    sources += [
      "layered_window_updater_impl.cc",
      "layered_window_updater_impl.h",
    ]
  }

  deps = [
    "//base",
    "//components/base32",
    "//components/input",
    "//components/persistent_cache",
    "//gpu/ipc/client",
    "//gpu/ipc/common",
    "//gpu/webgpu:common",
    "//services/viz/privileged/mojom",
    "//services/viz/privileged/mojom/compositing",
    "//services/webnn/host",
    "//services/webnn/public/mojom",
    "//ui/base",
    "//ui/base:ozone_buildflags",
    "//ui/gfx",
  ]

  public_deps = [
    "//components/viz/common",
    "//gpu/command_buffer/client",
    "//gpu/ipc/host",
    "//services/viz/public/mojom",
    "//ui/gfx/geometry",
  ]

  if (is_apple) {
    deps += [ "//ui/accelerated_widget_mac" ]
  }

  if (use_ozone) {
    deps += [ "//ui/ozone" ]
  }

  if (arkweb_oop_gpu_process) {
    deps += [ "//arkweb/build/features" ]
  }
  if (is_ohos) {
    deps += [ "//components/discardable_memory/service", "//components/viz/service" ]
  }
}

viz_source_set("unit_tests") {
  testonly = true

  sources = [ "host_frame_sink_manager_unittest.cc" ]

  if (enable_skia_graphite_tests) {
    sources += [ "persistent_cache_sandboxed_file_factory_unittest.cc" ]
  }

  deps = [
    ":host",
    "//base",
    "//base/test:test_support",
    "//components/viz/test:test_support",
    "//gpu/ipc/host",
    "//media:media_buildflags",
    "//mojo/public/cpp/bindings",
    "//services/viz/privileged/mojom",
    "//services/viz/public/mojom",
    "//testing/gmock",
    "//testing/gtest",
  ]

  if (use_ozone) {
    deps += [ "//ui/ozone" ]
  }

  import("//arkweb/chromium_ext/components/viz/host/arkweb_viz_host_ext.gni")
  sources += components_viz_host_unittests_ext.sources
  sources -= components_viz_host_unittests_ext.sources_del
  deps += components_viz_host_unittests_ext.deps
}
