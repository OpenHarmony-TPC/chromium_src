fragmentShader:"\n    uniform sampler2D tOriginalImg;\n    uniform sampler2D tSmoothImg;\n    uniform sampler2D tFaceMask;\n    uniform sampler2D tSmoothRegionMap;\n    uniform sampler2D tSharpRegionMap;\n\n    uniform float strength;\n\n    uniform vec4 lightColor;\n    uniform vec3 baseColor;\n    uniform vec3 shadowTritoneMidColor;\n    uniform float lipsContourShiftValue;\n    uniform float lipstickOpacity;\n    uniform float shadowGamma;\n    uniform float midtoneInputWhite;\n    uniform float midtoneOpacity;\n    uniform float highlightGamma;\n    uniform float highlightInputBlack;\n    uniform float highlightOpacity;\n    uniform bool transparentColor;\n\n    varying vec2 vTexCoord;\n    varying vec2 vImgCoord;\n    varying vec2 vScreenUv;\n\n    float ApplyLevelsFilter(\n        float x, float gamma, float inputBlack, float inputWhite) {\n      return pow(\n          clamp((x - inputBlack) / (inputWhite - inputBlack), 0.0, 1.0),\n          1.0 / gamma);\n    }\n\n    vec3 ApplyLevelsFilter(\n        vec3 x, float gamma, float inputBlack, float inputWhite) {\n      return pow(\n          clamp((x - inputBlack) / (inputWhite - inputBlack), 0.0, 1.0),\n          vec3(1.0 / gamma));\n    }\n\n    vec3 GetShadowsColorRgb(float normalizedOriginalIntensity,\n                            vec3 lipstickColor) {\n      vec3 tritoneColor =\n          mix(2.0 * normalizedOriginalIntensity * shadowTritoneMidColor,\n              2.0 * (\n                  shadowTritoneMidColor * (1.0 - normalizedOriginalIntensity)\n                      + normalizedOriginalIntensity) - 1.0,\n              step(0.5, normalizedOriginalIntensity));\n\n      return ApplyLevelsFilter(\n        tritoneColor, shadowGamma, 0.0, 1.0) * lipstickColor;\n    }\n\n    vec3 GetMidtonesColorRgb(float originalIntensity, vec3 lipstickColor) {\n      return ApplyLevelsFilter(\n        originalIntensity * lipstickColor, 1.0, 0.0, midtoneInputWhite);\n    }\n\n    vec3 GetHighlightsColorRgb(float normalizedOr