+ (2.0 * src_pixel.rgb - src_pixel.a) * (mix(\n          ((16.0 * dst_pixel.rgb - 12.0) * dst_pixel.rgb + 4.0) * dst_pixel.rgb,\n          sqrt(dst_pixel.rgb),\n          step(0.25, dst_pixel.rgb)) - dst_pixel.rgb),\n      step(0.5 * src_pixel.a, src_pixel.rgb));\n}\n\n    void main() {\n      float in_bounds_factor = step(0.0, min(vTexCoord.x, vTexCoord.y)) *\n                               step(max(vTexCoord.x, vTexCoord.y), 1.0);\n\n      vec4 style_original_color = texture(tEyelinerColor, vTexCoord);\n      float user_set_base = baseColor.r + baseColor.g + baseColor.b;\n      vec3 result_color_rgb = user_set_base > 0.0 ?\n          (baseColor * style_original_color.a) : style_original_color.rgb;\n      float result_color_a = style_original_color.a;\n      float faceMask = step(0.4, texture2D(tFaceMask, vTexScreenPos).r);\n\n      gl_FragColor = PremultiplyAlpha(lightColor) * in_bounds_factor * faceMask\n                      * strength * vec4(result_color_rgb, result_color_a);\n    }\n  "},
